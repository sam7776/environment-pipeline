pipeline {
  agent any
  environment {
    namemera = "Nishant ashok meshram"
    teranaam = "Kanchan Sonwane"
  }
  stages {
    stage("Git check") {
      steps {
        sh '''
          rm -rf jenkins-pipeline
          git clone https://github.com/sam7776/jenkins-pipeline.git
          echo 'Git working successfully'
        '''
      }
    }
    stage("Env Test") {
      steps {
        sh '''
          # Custom Env Variables
          echo "my name is ${namemera}"
          echo "her name is ${teranaam}"
        '''
      }
    }
      stage(" Test Cases") {
      steps {
        sh '''
          # Default Env Variables
          echo "Build no is ${BUILD_NUMBER}"
          echo "Workspace is ${WORKSPACE}"
          echo "JOB NAME is ${JOB_NAME}"
        '''
      }
    }
  }
}
